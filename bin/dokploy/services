#!/usr/bin/env bash
#
# services — list compose services and filter them by status.
#
# Usage:
#   ./dokploy.sh services <platform|all> [options]
#
#   platform ∈ {kodemeio, idtpp, abcfood, local}, or `all` for every one.
#
# Options:
#   --problems       only services that are not `done` — the common case
#   --status S       only this exact status (done, error, idle, …); repeatable
#   --project P      only this Dokploy project
#   --name SUBSTR    only services whose name contains SUBSTR
#   --count          print one summary line per platform, nothing else
#   --json           machine-readable; exits 1 when any service is not `done`
#
# Examples:
#   ./dokploy.sh services idtpp                  # everything, grouped by status
#   ./dokploy.sh services idtpp --problems       # just what needs attention
#   ./dokploy.sh services all --status error     # the fleet's failures
#   ./dokploy.sh services all --count            # one line per platform
#
# Reads only — `compose list` is not in dokploy.yaml's guard table, so there is
# no --yes and no --dry-run.
#
# 🔴 THE STATUS FIELD IS `status`, NOT `composeStatus`. Both exist on the record
# and `composeStatus` is ALWAYS null, so a filter written against it silently
# matches every service and reports the whole fleet as broken. That is what a
# hand-written `jq 'select(.composeStatus != "done")'` did on 2026-09-07 — it
# returned all 47 idtpp services as problems. This tool exists partly so nobody
# has to remember which of the two fields is the real one.
#
# Everything on this fleet is deployed as compose: `applications list` and
# `databases list` return zero rows on every platform, so `compose list` IS the
# service inventory.
#
set -euo pipefail
# shellcheck source=./_boot.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_boot.sh"

[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { fd_usage_from_header "$0"; exit 0; }

for _a in "$@"; do
  [[ "$_a" == "--dry-run" || "$_a" == "--yes" ]] && { c_red "services only reads; it has no $_a."; exit 1; }
done

[[ $# -ge 1 ]] || { c_red "Need: <platform|all>"; fd_usage_from_header "$0"; exit 1; }

WHICH="$1"; shift
PROBLEMS=0; PROJECT=""; NAME=""; AS_JSON=0; COUNT=0
STATUSES=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --problems) PROBLEMS=1; shift ;;
    --status)   STATUSES+=("${2:-}"); shift 2 ;;
    --project)  PROJECT="${2:-}"; shift 2 ;;
    --name)     NAME="${2:-}"; shift 2 ;;
    --count)    COUNT=1; shift ;;
    --json)     AS_JSON=1; shift ;;
    *) c_red "Unknown option '$1'"; fd_usage_from_header "$0"; exit 2 ;;
  esac
done

CLI="$(fd_cli)"
need "$CLI" "Install it from kodemeio-skills/packages/$CLI"
need python3

# `all` fans out over every configured target. A target that cannot be reached
# is reported as such rather than skipped: a platform silently missing from a
# fleet-wide problem list reads as "no problems there".
TARGETS=()
if [[ "$WHICH" == "all" ]]; then
  mapfile -t TARGETS < <(fd_targets)
else
  fd_resolve "$WHICH"
  TARGETS=("$FD_TARGET")
fi

WORK="$(mktemp -d)"; trap 'rm -rf "$WORK"' EXIT

for t in ${TARGETS[@]+"${TARGETS[@]}"}; do
  prof="$(fd_profile_for "$t")"
  if [[ -z "$prof" ]]; then
    printf 'unreachable\n' > "$WORK/$t.err"
    continue
  fi
  # tr -d '\n': the CLI pretty-prints JSON; the reader below wants one blob.
  if ! "$CLI" -p "$prof" --json compose list > "$WORK/$t.json" 2>"$WORK/$t.stderr"; then
    head -c 200 "$WORK/$t.stderr" > "$WORK/$t.err" 2>/dev/null || echo "failed" > "$WORK/$t.err"
    rm -f "$WORK/$t.json"
  fi
done

PROBLEMS="$PROBLEMS" PROJECT="$PROJECT" NAME="$NAME" AS_JSON="$AS_JSON" COUNT="$COUNT" \
STATUSES="$(printf '%s\n' ${STATUSES[@]+"${STATUSES[@]}"})" WORK="$WORK" python3 - <<'PY'
import json, os, sys
from pathlib import Path

WORK = Path(os.environ["WORK"])
PROBLEMS = os.environ["PROBLEMS"] == "1"
AS_JSON = os.environ["AS_JSON"] == "1"
COUNT = os.environ["COUNT"] == "1"
PROJECT = os.environ["PROJECT"]
NAME = os.environ["NAME"]
WANT = {s for s in os.environ["STATUSES"].split("\n") if s.strip()}

RED, YEL, GRN, DIM, OFF = "\033[1;31m", "\033[1;33m", "\033[1;32m", "\033[2m", "\033[0m"
if not sys.stdout.isatty():
    RED = YEL = GRN = DIM = OFF = ""
# `done` is the only healthy terminal state. `idle` is a service Dokploy is not
# running — usually deliberate for staging, never safe to assume.
COLOR = {"done": GRN, "error": RED, "idle": YEL}

out, errors = {}, {}
for p in sorted(WORK.glob("*.json")):
    target = p.stem
    try:
        d = json.loads(p.read_text())
    except Exception:
        errors[target] = "unparseable response"
        continue
    rows = d if isinstance(d, list) else d.get("data", [])
    keep = []
    for r in rows:
        # `status`, never `composeStatus` — see the header.
        st = r.get("status") or "unknown"
        if PROBLEMS and st == "done":
            continue
        if WANT and st not in WANT:
            continue
        if PROJECT and r.get("project") != PROJECT:
            continue
        if NAME and NAME not in (r.get("name") or ""):
            continue
        keep.append({"name": r.get("name"), "status": st,
                     "project": r.get("project"), "composeId": r.get("composeId")})
    out[target] = {"total": len(rows), "matched": sorted(keep, key=lambda x: (x["status"], x["name"] or ""))}
for p in sorted(WORK.glob("*.err")):
    errors[p.stem] = p.read_text().strip() or "unreachable"

if AS_JSON:
    print(json.dumps({"platforms": out, "errors": errors}, indent=2))
    sys.exit(1 if errors or any(s["status"] != "done" for v in out.values() for s in v["matched"]) else 0)

bad_total = 0
for target, v in out.items():
    counts = {}
    for s in v["matched"]:
        counts[s["status"]] = counts.get(s["status"], 0) + 1
    summary = "  ".join(f"{COLOR.get(k, '')}{k} {n}{OFF}" for k, n in sorted(counts.items()))
    print(f"\n  {target}  —  {v['total']} service(s){'  ·  ' + summary if summary else ''}")
    if COUNT:
        bad_total += sum(n for k, n in counts.items() if k != "done")
        continue
    if not v["matched"]:
        print(f"    {DIM}nothing matched{OFF}")
        continue
    print()
    for s in v["matched"]:
        col = COLOR.get(s["status"], "")
        if s["status"] != "done":
            bad_total += 1
        print(f"    {col}{s['status']:<8}{OFF} {s['name']:<38} {DIM}{s['project'] or ''}{OFF}")

for target, msg in errors.items():
    print(f"\n  {RED}{target}: could not list services — {msg}{OFF}")

print()
if errors:
    print(f"  {RED}VERDICT: {len(errors)} platform(s) could not be listed.{OFF}")
    sys.exit(1)
if bad_total:
    print(f"  {YEL}VERDICT: {bad_total} service(s) not in `done`.{OFF}")
    sys.exit(1)
print(f"  {GRN}VERDICT: every listed service is `done`.{OFF}")
PY
