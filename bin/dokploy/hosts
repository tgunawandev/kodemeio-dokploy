#!/usr/bin/env bash
#
# hosts — the servers behind a platform, with their real resource use.
#
# Usage:
#   ./dokploy.sh hosts <platform> [options]
#
# Options:
#   --no-ssh        Dokploy's own record only; no live stats
#   --no-hetzner    skip the Hetzner Cloud cross-check
#   --services      list the services assigned to each host (one extra API call
#                   per service, so it is opt-in)
#   --jobs N        parallelism for that mapping (default 8)
#   --describe      preview a description for each server, generated from the
#                   services on it; add --yes to write it to Dokploy
#   --force         also replace descriptions a person wrote by hand
#   --name SUBSTR   only hosts whose name contains SUBSTR
#   --disk-warn N   disk %% that counts as a problem   (default 85)
#   --load-warn N   load per core that counts as a problem (default 1.5, 5-min avg)
#   --mem-warn N    memory %% that counts as a problem (default 90)
#   --json          machine-readable; exits 1 on any problem or unreachable host
#
# Examples:
#   ./dokploy.sh hosts idtpp
#   ./dokploy.sh hosts idtpp --services
#   ./dokploy.sh hosts idtpp --name prod-03
#   ./dokploy.sh hosts idtpp --json
#
# Reads only — `servers list` plus one read-only SSH per host. No --yes, no
# --dry-run.
#
# 🔴 WHY THIS DOES NOT USE `servers metrics`. Dokploy has that endpoint and it
# returns `APIError 400: Input validation failed` on every server here, because
# the monitoring agent has never been provisioned: all seven idtpp servers carry
# an EMPTY `metricsConfig.server.token` and `thresholds {cpu: 0, memory: 0}`
# (checked 2026-09-07). Until somebody runs `servers setup-monitoring`, the API
# has no numbers to give, so this reads the hosts directly over SSH.
#
# 🔴 WHY IT IS NOT CALLED `servers`. kctl-dokploy owns a `servers` group, and a
# repo tool by that name would parse <platform> as its own first argument — two
# live meanings for one typed line, which is the ambiguity `ambiguous:` in
# dokploy.yaml exists to refuse. Naming it `hosts` avoids the collision entirely
# and keeps `./dokploy.sh <platform> servers list` working as passthrough.
#
# 🔴 THREE SOURCES, BECAUSE THEY DISAGREE. Dokploy's `serverStatus` is a stored
# record, not a liveness check: on 2026-09-07 it reported tpp-prod-05 `active`
# while SSH could not reach it AND Hetzner had no such server at all — a
# deleted machine still listed as a deploy target. Hetzner Cloud is the
# authority on whether the machine EXISTS, SSH on whether it is USABLE, and
# Dokploy only on whether it is CONFIGURED. A host missing from Hetzner is
# marked GHOST.
#
# 🔴 AN UNREACHABLE HOST IS REPORTED, NEVER SKIPPED. A server missing from a
# capacity report reads as "nothing wrong there". tpp-prod-05 is unreachable
# today and says so.
#
set -euo pipefail
# shellcheck source=./_boot.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_boot.sh"

[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { fd_usage_from_header "$0"; exit 0; }
# hosts is read-only EXCEPT for --describe --yes, which writes each server's
# description field. --yes is refused on its own so it cannot be pasted in from
# another command and silently do nothing.
_want_describe=0
for _a in "$@"; do [[ "$_a" == "--describe" ]] && _want_describe=1; done
for _a in "$@"; do
  [[ "$_a" == "--dry-run" ]] && { c_red "hosts has no --dry-run; without --yes it already only previews."; exit 1; }
  if [[ "$_a" == "--yes" && $_want_describe -eq 0 ]]; then
    c_red "--yes is only meaningful with --describe; everything else here reads."
    exit 1
  fi
done
[[ $# -ge 1 ]] || { c_red "Need: <platform>"; fd_usage_from_header "$0"; exit 1; }

PLATFORM="$1"; shift
fd_resolve "$PLATFORM"

NO_SSH=0; NO_HZ=0; WITH_SVC=0; DESCRIBE=0; ASSUME_YES=0; FORCE=0; FD_JOBS=8; NAME=""; DISK_WARN=85; MEM_WARN=90; LOAD_WARN=1.5; AS_JSON=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --no-ssh)     NO_SSH=1; shift ;;
    --no-hetzner) NO_HZ=1; shift ;;
    --services)   WITH_SVC=1; shift ;;
    --jobs)       FD_JOBS="${2:-8}"; shift 2 ;;
    --describe)   WITH_SVC=1; DESCRIBE=1; shift ;;
    --force)      FORCE=1; shift ;;
    --yes)        ASSUME_YES=1; shift ;;
    --name)      NAME="${2:-}"; shift 2 ;;
    --disk-warn) DISK_WARN="${2:-85}"; shift 2 ;;
    --load-warn) LOAD_WARN="${2:-1.5}"; shift 2 ;;
    --mem-warn)  MEM_WARN="${2:-90}"; shift 2 ;;
    --json)      AS_JSON=1; shift ;;
    *) c_red "Unknown option '$1'"; fd_usage_from_header "$0"; exit 2 ;;
  esac
done

CLI="$(fd_cli)"
need "$CLI" "Install it from kodemeio-skills/packages/$CLI"
need python3

WORK="$(mktemp -d)"; trap 'rm -rf "$WORK"' EXIT
(( AS_JSON )) || c_dim "▶ ${FD_TARGET}  profile=${FD_PROFILE}  hosts"

"$CLI" -p "$FD_PROFILE" --json servers list > "$WORK/servers.json" 2>/dev/null || {
  c_red "Could not list servers on ${FD_TARGET}."; exit 1; }

mapfile -t ROWS < <(NAME="$NAME" python3 -c "
import json, os
d=json.load(open('$WORK/servers.json')); r=d if isinstance(d,list) else d.get('data',[])
f=os.environ['NAME']
for x in r:
    n=x.get('name') or '?'
    if f and f not in n: continue
    print('\t'.join([n, x.get('ipAddress') or '', x.get('username') or 'root',
                     str(x.get('port') or 22), x.get('serverStatus') or '?', x.get('serverId') or '']))
")

# One read-only probe per host. `ssh -n` matters: without it ssh consumes this
# loop's stdin and only the first host is ever visited — a silent truncation
# that looks exactly like a short server list.
: > "$WORK/stats.tsv"
for row in ${ROWS[@]+"${ROWS[@]}"}; do
  IFS=$'\t' read -r name ip user port status sid <<<"$row"
  if (( NO_SSH )) || [[ -z "$ip" ]]; then
    printf '%s\t%s\t%s\t%s\t\t%s\n' "$name" "$ip" "$status" "skipped" "$sid" >> "$WORK/stats.tsv"
    continue
  fi
  (( AS_JSON )) || printf '\r  probing %-20s' "$name" >&2
  out="$(timeout 25 ssh -n -o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=accept-new \
        -p "$port" "$user@$ip" '
      cores=$(nproc 2>/dev/null || echo 1)
      # Field 2 = the 5-MINUTE average, deliberately not field 1. The 1-minute
      # figure spikes on any single build or backup run, and a load threshold
      # that fires on a spike is an alarm people learn to ignore.
      load=$(cut -d" " -f2 /proc/loadavg 2>/dev/null || echo 0)
      read _ mt ma _ < <(free -m | awk "/^Mem:/{print \$1, \$2, \$7}")
      dl=$(df -P / | awk "NR==2{print \$2, \$3, \$5}")
      ctr=$(docker ps -q 2>/dev/null | wc -l)
      recl=$(docker system df --format "{{.Reclaimable}}" 2>/dev/null | head -1)
      up=$(awk "{printf \"%d\", \$1/86400}" /proc/uptime 2>/dev/null || echo 0)
      echo "CORES=$cores LOAD=$load MEMTOTAL=$mt MEMAVAIL=$ma DISK=$dl CTR=$ctr UPDAYS=$up RECL=$recl"
    ' 2>/dev/null)" || out=""
  if [[ -z "$out" ]]; then
    printf '%s\t%s\t%s\t%s\t\t%s\n' "$name" "$ip" "$status" "unreachable" "$sid" >> "$WORK/stats.tsv"
  else
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "$ip" "$status" "ok" "$out" "$sid" >> "$WORK/stats.tsv"
  fi
done
(( AS_JSON )) || printf '\r%*s\r' 40 '' >&2

# Hetzner Cloud: does the machine actually exist, and what is it? Uses the same
# platform profile name — kctl-hz and kctl-dokploy share the profile taxonomy.
: > "$WORK/hetzner.json"
if (( ! NO_HZ )) && command -v kctl-hz >/dev/null 2>&1; then
  kctl-hz -p "$FD_PROFILE" --json servers list > "$WORK/hetzner.json" 2>/dev/null || : > "$WORK/hetzner.json"
fi

# Which services Dokploy has ASSIGNED to each host. `compose list` does not
# carry serverId — only the per-service detail does — so this is one call each
# and therefore opt-in. It is Dokploy's own view of placement, which is worth
# having beside the container count: the two disagreeing is exactly how a
# service pinned to a deleted server shows up.
: > "$WORK/placement.tsv"
if (( WITH_SVC )); then
  mapfile -t SVCS < <("$CLI" -p "$FD_PROFILE" --json compose list 2>/dev/null | python3 -c "
import json,sys
d=json.load(sys.stdin); r=d if isinstance(d,list) else d.get('data',[])
for x in r: print(x['composeId'] + chr(9) + (x.get('name') or '?') + chr(9) + (x.get('status') or '?'))
")
  n=${#SVCS[@]}
  (( AS_JSON )) || c_dim "  mapping $n service(s) to hosts, $FD_JOBS at a time..."
  # PARALLEL, because this is one API call per service and 45 in series took 81
  # seconds measured — long enough that people stop using the flag.
  #
  # Concurrent appends are safe: each line is a few dozen bytes, far below
  # PIPE_BUF, so O_APPEND writes cannot interleave. Order is not preserved and
  # does not matter — the reader groups by serverId.
  export _FD_CLI="$CLI" _FD_PROF="$FD_PROFILE"
  printf '%s\n' ${SVCS[@]+"${SVCS[@]}"} \
    | xargs -P "$FD_JOBS" -d '\n' -I{} bash -c '
        IFS=$'"'"'\t'"'"' read -r cid cname cstatus <<<"$1"
        sid="$("$_FD_CLI" -p "$_FD_PROF" --json compose get "$cid" 2>/dev/null \
               | python3 -c "
import json,sys
try:
    d=json.load(sys.stdin); d=d.get(\"data\",d) if isinstance(d,dict) else d
    print(d.get(\"serverId\") or \"\")
except Exception: print(\"\")" || true)"
        printf "%s\t%s\t%s\n" "${sid:-none}" "$cname" "$cstatus"
      ' _ {} >> "$WORK/placement.tsv"
fi

# set +e so a non-zero verdict from the reader does not skip the apply below;
# its exit code is captured and re-raised at the end.
set +e
DISK_WARN="$DISK_WARN" MEM_WARN="$MEM_WARN" LOAD_WARN="$LOAD_WARN" AS_JSON="$AS_JSON" TARGET="$FD_TARGET" \
DESCRIBE="$DESCRIBE" FORCE="$FORCE" \
WORK="$WORK" python3 - <<'PY'
import json, os, re, sys
from datetime import datetime, timezone
from pathlib import Path

WORK = Path(os.environ["WORK"])
DW = float(os.environ["DISK_WARN"]); MW = float(os.environ["MEM_WARN"])
LW = float(os.environ["LOAD_WARN"])
AS_JSON = os.environ["AS_JSON"] == "1"; TARGET = os.environ["TARGET"]
DESCRIBE = os.environ.get("DESCRIBE") == "1"
FORCE = os.environ.get("FORCE") == "1"

def kv(blob):
    out = {}
    for m in re.finditer(r"(\w+)=(\S+(?: \S+)*?)(?=\s+\w+=|$)", blob.strip()):
        out[m.group(1)] = m.group(2).strip()
    return out

# Hetzner inventory, keyed by public IPv4 — names can differ between systems,
# an IP cannot.
hz_by_ip, hz_seen = {}, False
try:
    raw = (WORK / "hetzner.json").read_text().strip()
    if raw:
        d = json.loads(raw)
        for s in (d if isinstance(d, list) else d.get("data", [])):
            pn = s.get("public_net") or {}
            ip = (pn.get("ipv4") or {}).get("ip") if isinstance(pn, dict) else None
            ip = ip or s.get("ipv4") or s.get("ip")
            if ip:
                st = s.get("server_type") or {}
                hz_by_ip[ip] = {"name": s.get("name"), "status": s.get("status"),
                                "type": st.get("name") if isinstance(st, dict) else st}
        hz_seen = True
except Exception:
    hz_seen = False

# serverId -> services assigned to it
placement = {}
_pl = WORK / "placement.tsv"
if _pl.is_file():
    for line in _pl.read_text().splitlines():
        bits = line.split("\t")
        if len(bits) == 3:
            placement.setdefault(bits[0], []).append({"name": bits[1], "status": bits[2]})

# Current descriptions, straight from the server records, so the preview can
# show now-vs-new rather than asserting a change it has not checked for.
current_desc = {}
try:
    _s = json.loads((WORK / "servers.json").read_text())
    for x in (_s if isinstance(_s, list) else _s.get("data", [])):
        current_desc[x.get("serverId") or ""] = x.get("description") or ""
except Exception:
    pass

TODAY = datetime.now(timezone.utc).strftime("%Y-%m-%d")

hosts, problems = [], []
for line in (WORK / "stats.tsv").read_text().splitlines():
    parts = line.split("\t")
    name, ip, status, probe = parts[0], parts[1], parts[2], parts[3]
    blob = parts[4] if len(parts) > 4 else ""
    sid = parts[5] if len(parts) > 5 else ""
    h = {"name": name, "ip": ip, "dokploy_status": status, "probe": probe, "server_id": sid}
    h["services"] = sorted(placement.get(sid, []), key=lambda x: x["name"])
    if hz_seen:
        hz = hz_by_ip.get(ip)
        h["hetzner"] = hz["status"] if hz else "absent"
        h["hetzner_type"] = hz["type"] if hz else None
    if probe == "ok" and blob:
        d = kv(blob)
        try:
            cores = int(d.get("CORES", 1)) or 1
            load = float(d.get("LOAD", 0))
            mt = int(d.get("MEMTOTAL", 0)); ma = int(d.get("MEMAVAIL", 0))
            dt, du, dpct = (d.get("DISK", "0 0 0%").split() + ["0", "0", "0%"])[:3]
            h.update({
                "cores": cores, "load": load, "load_per_core": round(load / cores, 2),
                "mem_total_mb": mt, "mem_used_mb": mt - ma,
                "mem_pct": round((mt - ma) / mt * 100, 1) if mt else None,
                "disk_pct": float(dpct.rstrip("%")),
                "disk_total_gb": round(int(dt) / 1048576, 1),
                "containers": int(d.get("CTR", 0)),
                "uptime_days": int(d.get("UPDAYS", 0)),
                "docker_reclaimable": d.get("RECL", ""),
            })
        except (ValueError, ZeroDivisionError):
            h["probe"] = "unparseable"
    hosts.append(h)

    why = []
    if h.get("hetzner") == "absent":
        why.append("GHOST — no such server in Hetzner")
    elif h.get("hetzner") not in (None, "running"):
        why.append(f"Hetzner says {h['hetzner']}")
    if h["probe"] == "unreachable":
        why.append("unreachable over SSH")
    if h.get("disk_pct") is not None and h["disk_pct"] >= DW:
        why.append(f"disk {h['disk_pct']:.0f}%")
    if h.get("mem_pct") is not None and h["mem_pct"] >= MW:
        why.append(f"memory {h['mem_pct']:.0f}%")
    if h.get("load_per_core") is not None and h["load_per_core"] >= LW:
        why.append(f"load {h['load_per_core']}/core")
    if why:
        problems.append((name, ", ".join(why)))

if AS_JSON:
    print(json.dumps({"target": TARGET, "hosts": hosts,
                      "thresholds": {"disk_pct": DW, "mem_pct": MW, "load_per_core": LW},
                      "problems": [{"host": a, "why": b} for a, b in problems]}, indent=2))
    sys.exit(1 if problems else 0)

RED, YEL, GRN, DIM, OFF = "\033[1;31m", "\033[1;33m", "\033[1;32m", "\033[2m", "\033[0m"
if not sys.stdout.isatty():
    RED = YEL = GRN = DIM = OFF = ""

def colour_for(v, warn):
    if v is None:
        return ""
    return RED if v >= warn else (YEL if v >= warn - 15 else "")

def cell(text, width, colour="", right=True):
    """Pad to `width` on the PLAIN text, then wrap in colour.

    printf-style width counts ANSI bytes, so colouring before padding shifts
    every column right of it — which is what the first version of this table
    did. Pad first, colour second.
    """
    pad = text.rjust(width) if right else text.ljust(width)
    return f"{colour}{pad}{OFF}" if colour else pad

def svc_grid(svcs, indent="      ", width=78):
    """Service names in aligned columns, widest-name driven.

    The first version wrapped names into a ragged run-on paragraph, which is
    unreadable at 12 services on one host: nothing lines up, so the eye cannot
    scan down a column to find a name.
    """
    if not svcs:
        return
    w = max(len(s["name"]) for s in svcs) + 2
    cols = max(1, (width - len(indent)) // w)
    rows = (len(svcs) + cols - 1) // cols
    for r in range(rows):
        cells = []
        for c in range(cols):
            i = r + c * rows          # column-major: read DOWN, then across
            if i >= len(svcs):
                continue
            s = svcs[i]
            col = "" if s["status"] == "done" else (RED if s["status"] == "error" else YEL)
            pad = s["name"].ljust(w)
            cells.append(f"{col}{pad}{OFF}" if col else pad)
        print(indent + "".join(cells).rstrip())


hz_col = "hetzner" if hz_seen else ""
print(f"\n  {'host':<14}{'dokploy':<9}{hz_col:<10}{'cpu 5m':>10}{'memory':>16}{'disk':>14}{'ctr':>6}{'up':>7}")
print("  " + "─" * (78 + (10 if hz_seen else 0)))
for h in hosts:
    hzc = ""
    if hz_seen:
        v = h.get("hetzner") or "?"
        hzc = cell(v, 10, RED if v == "absent" else ("" if v == "running" else YEL), right=False)
    if h["probe"] != "ok":
        col = RED if h["probe"] == "unreachable" else DIM
        print(f"  {h['name']:<14}{h['dokploy_status']:<9}{hzc}{cell(h['probe'], 10, col)}")
        if placement:
            svcs = h.get("services") or []
            print(f"      {DIM}{len(svcs)} service(s){OFF}" if svcs else f"      {DIM}no services assigned{OFF}")
            svc_grid(svcs)
            print()
        continue
    cpu = cell(f"{h['load_per_core']:.2f}/core", 10, RED if h["load_per_core"] >= LW else "")
    mem_txt = f"{h['mem_used_mb'] // 1024}/{h['mem_total_mb'] // 1024}G {h['mem_pct']:.0f}%"
    disk_txt = f"{h['disk_total_gb']:.0f}G {h['disk_pct']:.0f}%"
    print(f"  {h['name']:<14}{h['dokploy_status']:<9}{hzc}{cpu}"
          f"{cell(mem_txt, 16, colour_for(h['mem_pct'], MW))}"
          f"{cell(disk_txt, 14, colour_for(h['disk_pct'], DW))}"
          f"{h['containers']:>6}{str(h['uptime_days']) + 'd':>7}")
    if placement:
        svcs = h.get("services") or []
        print(f"      {DIM}{len(svcs)} service(s){OFF}" if svcs else f"      {DIM}no services assigned{OFF}")
        svc_grid(svcs)
        print()

recl = [h for h in hosts if h.get("docker_reclaimable") and not h["docker_reclaimable"].startswith("0")]
if recl:
    print(f"\n  {DIM}Docker reclaimable: " + "  ".join(f"{h['name']} {h['docker_reclaimable']}" for h in recl) + OFF)

# A service with NO serverId still runs somewhere — the field is simply absent
# from Dokploy's record, and it does NOT mean "on the control plane".
# Demonstrated 2026-09-07: tpp-odoo-filestore-backup carries no serverId, yet its
# container is on tpp-prod-03 (`docker ps` there shows
# compose-index-mobile-interface-my7gz1-filestore-backup-1) — which it must be,
# since it mounts that host's odoo-filestore volume.
#
# So these are listed as "placement not recorded", not attributed to a host.
# Guessing would be worse than saying nothing: the whole point of this view is
# to be trusted about where things run.
if placement:
    house = placement.get("none", []) + placement.get("", [])
    if house:
        print(f"\n  {DIM}placement not recorded by Dokploy (no serverId) — these still run somewhere;{OFF}")
        print(f"  {DIM}check with: ./dokploy.sh <platform> docker containers -s <host>{OFF}")
        svc_grid(sorted(house, key=lambda x: x["name"]))
    total = sum(len(v) for v in placement.values())
    shown = sum(len(h.get("services") or []) for h in hosts) + len(house)
    if shown != total:
        print(f"\n  {YEL}note: {total - shown} service(s) assigned to a server not in this list{OFF}")

def describe_for(h):
    """A factual description of a host, built from the services Dokploy places there.

    Grouped by the common `<tenant>-<family>` prefix so twelve names compress to
    something readable in a UI field, and NOT given an invented role label —
    "TPP shared infrastructure" would be a guess that quietly goes stale, while
    a list of what is actually there cannot.

    It ends with a generated-on marker for the same reason the manifests carry
    "GENERATED FROM": whoever opens this dialog next needs to know an edit here
    will be overwritten, and by what.
    """
    svcs = [s["name"] for s in (h.get("services") or [])]
    if not svcs:
        return f"No services assigned. Generated {TODAY} by ./dokploy.sh hosts --describe"
    groups = {}
    for n in sorted(svcs):
        bits = n.split("-")
        key = "-".join(bits[:2]) if len(bits) > 2 else n
        groups.setdefault(key, []).append("-".join(bits[2:]) if len(bits) > 2 else n)
    parts = []
    for key, members in sorted(groups.items()):
        if len(members) == 1 and members[0] == key:
            parts.append(key)
        elif len(members) == 1:
            parts.append(f"{key}-{members[0]}")
        else:
            parts.append(f"{key} x{len(members)} ({', '.join(sorted(members))})")
    body = " | ".join(parts)
    desc = f"{len(svcs)} services: {body}. Generated {TODAY} by ./dokploy.sh hosts --describe -- edits here are overwritten."
    return desc if len(desc) <= 480 else desc[:477] + "..."

MARKER = "./dokploy.sh hosts --describe"

if DESCRIBE:
    plan, protected = [], []
    print(f"\n  DESCRIPTIONS — generated from placement\n")
    for h in hosts:
        sid = h.get("server_id") or ""
        cur = (current_desc.get(sid) or "").strip()
        new = describe_for(h)
        same = cur == new
        # 🔴 NEVER CLOBBER A HUMAN'S NOTE. A description that is non-empty and
        # does NOT carry this tool's marker was written by a person —
        # tpp-prod-01 said "Postgres, Authentik, Mailcow" and tpp-prod-02 said
        # "Odoo MAC, Postgres MAC, HRMS MAC". Overwriting those silently would
        # destroy the only place someone recorded intent, in exchange for a list
        # the tool can print on demand anyway. --force is the deliberate override.
        mine = (not cur) or (MARKER in cur)
        print(f"  {h['name']}")
        print(f"    {DIM}now :{OFF} {cur if cur else DIM + '(empty)' + OFF}")
        if not mine and not FORCE:
            print(f"    {YEL}skip:{OFF} hand-written, kept. --force to replace it with:")
            print(f"    {DIM}      {new}{OFF}")
            protected.append(h["name"])
        else:
            print(f"    {GRN if not same else DIM}new :{OFF} {new}")
            if not same and sid:
                plan.append((sid, h["name"], new))
        print()
    (WORK / "describe.tsv").write_text(
        "".join(f"{sid}\t{name}\t{d}\n" for sid, name, d in plan), encoding="utf-8")
    if protected:
        print(f"  {YEL}{len(protected)} hand-written description(s) kept: {', '.join(protected)}{OFF}")
    if plan:
        print(f"  {YEL}{len(plan)} server(s) would change. Re-run with --yes to write them.{OFF}")
    elif not protected:
        print(f"  {GRN}Every description already matches.{OFF}")

print()
if problems:
    for name, why in problems:
        print(f"  {RED}✗{OFF} {name}: {why}")
    print(f"\n  {RED}VERDICT: {len(problems)} host(s) need attention.{OFF}")
    sys.exit(1)
print(f"  {GRN}VERDICT: all {len(hosts)} hosts within thresholds.{OFF}")
PY
_reader_rc=$?
set -e

# ── Apply, only with --describe --yes ────────────────────────────────────────
# The plan was written by the reader above, so what gets applied is exactly what
# was printed — there is no second generation pass that could differ from the
# preview.
if (( DESCRIBE && ASSUME_YES )); then
  if [[ ! -s "$WORK/describe.tsv" ]]; then
    c_dim "Nothing to write."
  else
    _n=0
    while IFS=$'\t' read -r _sid _name _desc; do
      [[ -n "$_sid" ]] || continue
      if "$CLI" -p "$FD_PROFILE" servers update "$_sid" --description "$_desc" >/dev/null 2>&1; then
        c_green "updated  $_name"
        _n=$(( _n + 1 ))
      else
        c_red "FAILED   $_name"
      fi
    done < "$WORK/describe.tsv"
    c_dim "$_n description(s) written."
  fi
fi

exit "$_reader_rc"
