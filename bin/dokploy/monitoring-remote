#!/usr/bin/env bash
# Bounded monitoring-host operations; operator only, never an OMP tool.
# Usage: ./dokploy.sh monitoring-remote <platform> <server-id> <action> [options]
set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_boot.sh"
[[ $# -ge 1 ]] || { fd_usage_from_header "$0"; exit 2; }
fd_resolve "$1"
shift
exec python3 "$FD_REPO_ROOT/ops/scripts/monitoring_remote.py" --profile "$FD_PROFILE" "$@"
