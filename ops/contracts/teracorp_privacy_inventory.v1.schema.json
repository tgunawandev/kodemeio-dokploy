{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kodeme.io/teracorp/privacy-inventory.v1.schema.json",
  "title": "Teracorp G7 Privacy Inventory v1",
  "description": "Offline structural inventory only; not legal advice, verification, compliance, or deletion proof. JSON Schema checks shape and basic conditions; use the Python validator for cross-record references, uniqueness, and chronology.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "as_of_date", "processor_inventory_status", "processors", "evidence_refs", "purpose_registry", "products"],
  "properties": {
    "schema_version": {"const": 1},
    "as_of_date": {"$ref": "#/$defs/date"},
    "processor_inventory_status": {"enum": ["complete", "none_declared", "unknown"]},
    "processors": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/processor"}},
    "evidence_refs": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/evidence"}},
    "purpose_registry": {"type": "array", "maxItems": 2048, "items": {"$ref": "#/$defs/purpose"}},
    "products": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/product"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "date": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "refs": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "purpose": {
      "type": "object", "additionalProperties": false,
      "required": ["product_id", "purpose_id"],
      "properties": {"product_id": {"$ref": "#/$defs/id"}, "purpose_id": {"$ref": "#/$defs/id"}}
    },
    "processor": {
      "type": "object", "additionalProperties": false,
      "required": ["processor_id", "inventory_status", "evidence_refs"],
      "properties": {
        "processor_id": {"$ref": "#/$defs/id"},
        "inventory_status": {"enum": ["identified", "unknown"]},
        "evidence_refs": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/id"}}
      },
      "allOf": [{
        "if": {"properties": {"inventory_status": {"const": "identified"}}, "required": ["inventory_status"]},
        "then": {"properties": {"evidence_refs": {"$ref": "#/$defs/refs"}}}
      }]
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_ref_id", "sha256", "observed_on"],
      "properties": {
        "evidence_ref_id": {"$ref": "#/$defs/id"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "observed_on": {"$ref": "#/$defs/date"}
      }
    },
    "dataFlow": {
      "type": "object", "additionalProperties": false,
      "required": ["flow_id", "processor_id", "purpose_id", "data_categories", "evidence_refs"],
      "properties": {
        "flow_id": {"$ref": "#/$defs/id"},
        "processor_id": {"$ref": "#/$defs/id"},
        "purpose_id": {"$ref": "#/$defs/id"},
        "data_categories": {
          "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
          "items": {"enum": ["account_profile", "contact", "child_data", "payment_metadata", "support_message", "usage_telemetry", "content_submission", "other"]}
        },
        "evidence_refs": {"$ref": "#/$defs/refs"}
      }
    },
    "product": {
      "type": "object", "additionalProperties": false,
      "required": ["product_id", "inventory_status", "consent_status", "consent_evidence_refs", "retention_status", "retention_evidence_refs", "deletion_test_status", "deletion_tested_on", "deletion_evidence_refs", "pia_status", "pia_evidence_refs", "data_flows"],
      "properties": {
        "product_id": {"$ref": "#/$defs/id"},
        "inventory_status": {"enum": ["complete", "unknown"]},
        "consent_status": {"enum": ["documented", "not_applicable_asserted", "unresolved"]},
        "consent_evidence_refs": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/id"}},
        "retention_status": {"enum": ["documented", "unresolved"]},
        "retention_evidence_refs": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/id"}},
        "deletion_test_status": {"enum": ["passed", "failed", "not_run", "unknown"]},
        "deletion_tested_on": {"oneOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
        "deletion_evidence_refs": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/id"}},
        "pia_status": {"enum": ["completed", "pending", "not_required_asserted", "unknown"]},
        "pia_evidence_refs": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/id"}},
        "data_flows": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/dataFlow"}}
      },
      "allOf": [
        {"if": {"properties": {"inventory_status": {"const": "complete"}}, "required": ["inventory_status"]}, "then": {"properties": {"data_flows": {"minItems": 1}}}},
        {"if": {"properties": {"consent_status": {"const": "documented"}}, "required": ["consent_status"]}, "then": {"properties": {"consent_evidence_refs": {"$ref": "#/$defs/refs"}}}},
        {"if": {"properties": {"retention_status": {"const": "documented"}}, "required": ["retention_status"]}, "then": {"properties": {"retention_evidence_refs": {"$ref": "#/$defs/refs"}}}},
        {"if": {"properties": {"pia_status": {"const": "completed"}}, "required": ["pia_status"]}, "then": {"properties": {"pia_evidence_refs": {"$ref": "#/$defs/refs"}}}},
        {"if": {"properties": {"deletion_test_status": {"enum": ["passed", "failed"]}}, "required": ["deletion_test_status"]}, "then": {"properties": {"deletion_tested_on": {"$ref": "#/$defs/date"}, "deletion_evidence_refs": {"$ref": "#/$defs/refs"}}}},
        {"if": {"properties": {"deletion_test_status": {"enum": ["not_run", "unknown"]}}, "required": ["deletion_test_status"]}, "then": {"properties": {"deletion_tested_on": {"type": "null"}, "deletion_evidence_refs": {"maxItems": 0}}}}
      ]
    }
  }
}
