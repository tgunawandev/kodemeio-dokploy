{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kodeme.io/ops/hooks/hook-performance-window.v1.schema.json",
  "title": "Hook Performance Window v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "window_id", "hook_id", "hook_version", "brand", "window_start", "window_end", "observed_on", "provenance", "source_id", "impressions", "engagements", "conversions", "evidence_ref_id"],
  "properties": {
    "schema_version": {"const": 1},
    "window_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "hook_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "hook_version": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "brand": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$", "description": "A brand code; valid iff brands/<code>.yaml exists (checked by ops/scripts/hook_library.py)."},
    "window_start": {"type": "string", "format": "date"},
    "window_end": {"type": "string", "format": "date"},
    "observed_on": {"type": "string", "format": "date"},
    "provenance": {"enum": ["real", "synthetic"]},
    "source_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "impressions": {"type": "integer", "minimum": 0, "maximum": 1000000000},
    "engagements": {"type": "integer", "minimum": 0, "maximum": 1000000000},
    "conversions": {"type": "integer", "minimum": 0, "maximum": 1000000000},
    "evidence_ref_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}
  }
}
