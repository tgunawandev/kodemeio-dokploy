{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kodeme.io/teracorp_g7_data_map.v1.schema.json",
  "title": "Teracorp G7 per-product data map (local completeness input)",
  "description": "A strict input shape, not a privacy assessment, legal conclusion, or compliance assertion.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_id", "as_of_date", "sections", "counsel_review"],
  "properties": {
    "schema_version": {"const": 1},
    "product_id": {"enum": ["B1", "B2", "B3", "B4", "B5", "B6", "B7", "B8", "B9", "B10", "B11", "B12"]},
    "as_of_date": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purposes": {"$ref": "#/$defs/purposes"},
        "data_categories": {"$ref": "#/$defs/data_categories"},
        "lawful_basis": {"$ref": "#/$defs/lawful_basis"},
        "consent": {"$ref": "#/$defs/consent"},
        "processing_operations": {"$ref": "#/$defs/processing_operations"},
        "processors": {"$ref": "#/$defs/processors"},
        "residency_transfers": {"$ref": "#/$defs/residency_transfers"},
        "retention": {"$ref": "#/$defs/retention"},
        "access_roles": {"$ref": "#/$defs/access_roles"},
        "deletion_procedure": {"$ref": "#/$defs/deletion_procedure"},
        "deletion_test": {"$ref": "#/$defs/deletion_test"},
        "pia": {"$ref": "#/$defs/pia"}
      }
    },
    "counsel_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "required_topics"],
      "properties": {
        "status": {"enum": ["not_started", "pending"]},
        "required_topics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S"},
    "evidence": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "status": {"enum": ["assessed", "unassessed"]},
    "purpose_item": {
      "type": "object", "additionalProperties": false,
      "required": ["purpose_id", "description", "evidence_ref"],
      "properties": {"purpose_id": {"$ref": "#/$defs/id"}, "description": {"$ref": "#/$defs/text"}, "evidence_ref": {"$ref": "#/$defs/evidence"}}
    },
    "purposes": {
      "type": "object", "additionalProperties": false, "required": ["status", "items"],
      "properties": {"status": {"$ref": "#/$defs/status"}, "items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/purpose_item"}}}
    },
    "data_category": {
      "type": "object", "additionalProperties": false,
      "required": ["category_id", "category", "classification", "source", "evidence_ref"],
      "properties": {
        "category_id": {"$ref": "#/$defs/id"}, "category": {"$ref": "#/$defs/text"},
        "classification": {"enum": ["ordinary", "sensitive", "child_related", "financial", "other", "unassessed"]},
        "source": {"$ref": "#/$defs/text"}, "evidence_ref": {"$ref": "#/$defs/evidence"}
      }
    },
    "data_categories": {
      "type": "object", "additionalProperties": false, "required": ["status", "items"],
      "properties": {"status": {"$ref": "#/$defs/status"}, "items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/data_category"}}}
    },
    "lawful_basis": {
      "type": "object", "additionalProperties": false,
      "required": ["decision", "basis_description", "rationale", "evidence_ref", "counsel_required"],
      "properties": {
        "decision": {"enum": ["proposed", "unresolved"]}, "basis_description": {"$ref": "#/$defs/text"},
        "rationale": {"$ref": "#/$defs/text"}, "evidence_ref": {"$ref": "#/$defs/evidence"}, "counsel_required": {"const": true}
      }
    },
    "consent": {
      "type": "object", "additionalProperties": false,
      "required": ["decision", "rationale", "evidence_ref", "counsel_required"],
      "properties": {
        "decision": {"enum": ["required", "not_required", "not_applicable", "unresolved"]},
        "rationale": {"$ref": "#/$defs/text"}, "evidence_ref": {"$ref": "#/$defs/evidence"}, "counsel_required": {"const": true}
      }
    },
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["operation_id", "product_id", "system_ref", "purpose_ref", "data_category_refs", "evidence_ref"],
      "properties": {
        "operation_id": {"$ref": "#/$defs/id"}, "product_id": {"enum": ["B1", "B2", "B3", "B4", "B5", "B6", "B7", "B8", "B9", "B10", "B11", "B12"]},
        "system_ref": {"$ref": "#/$defs/id"}, "purpose_ref": {"$ref": "#/$defs/id"},
        "data_category_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "evidence_ref": {"$ref": "#/$defs/evidence"}
      }
    },
    "processing_operations": {
      "type": "object", "additionalProperties": false, "required": ["status", "items"],
      "properties": {"status": {"$ref": "#/$defs/status"}, "items": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/operation"}}}
    },
    "processor": {
      "type": "object", "additionalProperties": false,
      "required": ["processor_id", "product_id", "role", "service_description", "data_received", "terms_status", "evidence_ref"],
      "properties": {
        "processor_id": {"$ref": "#/$defs/id"}, "product_id": {"enum": ["B1", "B2", "B3", "B4", "B5", "B6", "B7", "B8", "B9", "B10", "B11", "B12"]},
        "role": {"enum": ["internal", "controller", "processor", "subprocessor", "unassessed"]},
        "service_description": {"$ref": "#/$defs/text"}, "data_received": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "terms_status": {"enum": ["identified", "pending_counsel", "unassessed"]}, "evidence_ref": {"$ref": "#/$defs/evidence"}
      }
    },
    "processors": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "no_processors_declared", "items"],
      "properties": {"status": {"$ref": "#/$defs/status"}, "no_processors_declared": {"type": "boolean"}, "items": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/processor"}}}
    },
    "transfer": {
      "type": "object", "additionalProperties": false,
      "required": ["transfer_id", "destination", "mechanism_description", "assessment_status", "evidence_ref"],
      "properties": {
        "transfer_id": {"$ref": "#/$defs/id"}, "destination": {"$ref": "#/$defs/text"},
        "mechanism_description": {"$ref": "#/$defs/text"}, "assessment_status": {"enum": ["assessed", "pending_counsel", "unassessed"]}, "evidence_ref": {"$ref": "#/$defs/evidence"}
      }
    },
    "residency_transfers": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "known_locations", "no_transfers_declared", "transfers"],
      "properties": {
        "status": {"$ref": "#/$defs/status"}, "known_locations": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "no_transfers_declared": {"type": "boolean"}, "transfers": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/transfer"}}
      }
    },
    "retention_item": {
      "type": "object", "additionalProperties": false,
      "required": ["category_ref", "trigger", "period_description", "disposition", "decision_status", "evidence_ref"],
      "properties": {
        "category_ref": {"$ref": "#/$defs/id"}, "trigger": {"$ref": "#/$defs/text"}, "period_description": {"$ref": "#/$defs/text"},
        "disposition": {"$ref": "#/$defs/text"}, "decision_status": {"enum": ["proposed", "approved_by_owner", "unresolved", "unassessed"]}, "evidence_ref": {"$ref": "#/$defs/evidence"}
      }
    },
    "retention": {
      "type": "object", "additionalProperties": false, "required": ["status", "items"],
      "properties": {"status": {"$ref": "#/$defs/status"}, "items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/retention_item"}}}
    },
    "access_role": {
      "type": "object", "additionalProperties": false,
      "required": ["role_id", "access_description", "purpose", "evidence_ref"],
      "properties": {"role_id": {"$ref": "#/$defs/id"}, "access_description": {"$ref": "#/$defs/text"}, "purpose": {"$ref": "#/$defs/text"}, "evidence_ref": {"$ref": "#/$defs/evidence"}}
    },
    "access_roles": {
      "type": "object", "additionalProperties": false, "required": ["status", "items"],
      "properties": {"status": {"$ref": "#/$defs/status"}, "items": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/access_role"}}}
    },
    "deletion_step": {
      "type": "object", "additionalProperties": false, "required": ["step_id", "system_ref", "action", "verification", "evidence_ref"],
      "properties": {"step_id": {"$ref": "#/$defs/id"}, "system_ref": {"$ref": "#/$defs/id"}, "action": {"$ref": "#/$defs/text"}, "verification": {"$ref": "#/$defs/text"}, "evidence_ref": {"$ref": "#/$defs/evidence"}}
    },
    "deletion_procedure": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "owner_role", "request_route", "steps", "exceptions"],
      "properties": {
        "status": {"$ref": "#/$defs/status"}, "owner_role": {"$ref": "#/$defs/id"}, "request_route": {"$ref": "#/$defs/text"},
        "steps": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/deletion_step"}}, "exceptions": {"type": "array", "items": {"$ref": "#/$defs/text"}}
      }
    },
    "deletion_test": {
      "type": "object", "additionalProperties": false,
      "required": ["test_id", "product_id", "procedure_ref", "executed_on", "valid_until", "freshness_policy_ref", "freshness_policy_approved", "test_subject_ref", "expected_result", "observed_result", "result", "evidence_ref"],
      "properties": {
        "test_id": {"$ref": "#/$defs/id"}, "product_id": {"enum": ["B1", "B2", "B3", "B4", "B5", "B6", "B7", "B8", "B9", "B10", "B11", "B12"]},
        "procedure_ref": {"$ref": "#/$defs/id"}, "executed_on": {"type": "string", "format": "date"}, "valid_until": {"type": "string", "format": "date"},
        "freshness_policy_ref": {"$ref": "#/$defs/evidence"}, "freshness_policy_approved": {"const": true},
        "test_subject_ref": {"$ref": "#/$defs/id"}, "expected_result": {"$ref": "#/$defs/text"}, "observed_result": {"$ref": "#/$defs/text"},
        "result": {"enum": ["pass", "fail", "unassessed"]}, "evidence_ref": {"$ref": "#/$defs/evidence"}
      }
    },
    "pia_risk": {
      "type": "object", "additionalProperties": false,
      "required": ["risk_id", "scenario", "likelihood", "impact", "mitigation", "residual_risk", "evidence_ref"],
      "properties": {
        "risk_id": {"$ref": "#/$defs/id"}, "scenario": {"$ref": "#/$defs/text"}, "likelihood": {"enum": ["low", "medium", "high", "unassessed"]},
        "impact": {"enum": ["low", "medium", "high", "unassessed"]}, "mitigation": {"$ref": "#/$defs/text"}, "residual_risk": {"$ref": "#/$defs/text"}, "evidence_ref": {"$ref": "#/$defs/evidence"}
      }
    },
    "pia": {
      "type": "object", "additionalProperties": false, "required": ["status", "risks", "reviewer_role", "evidence_ref"],
      "properties": {
        "status": {"enum": ["prepared", "unassessed"]}, "risks": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/pia_risk"}},
        "reviewer_role": {"$ref": "#/$defs/text"}, "evidence_ref": {"$ref": "#/$defs/evidence"}
      }
    }
  }
}
