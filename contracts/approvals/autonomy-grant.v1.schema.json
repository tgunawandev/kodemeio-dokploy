{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodeme.io/contracts/approvals/autonomy-grant.v1.schema.json",
  "title": "Earned-autonomy grant v1",
  "description": "Founder-signed promotion of ONE promotable action class (autonomy.v1.yaml) to auto-approval for explicit profiles until expiry. The Ed25519 signature covers 'kodemeio.autonomy-grant.v1\\n' + canonical JSON (sorted keys, compact, ASCII) of every field except signature. Verification, class eligibility and expiry are enforced by ops/scripts/teracorp_autonomy_grant.py; always_human classes are refused even when validly signed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "grant_id", "action_class", "policy_version", "approver_role", "evidence_sha256", "scope", "issued_at", "expires_at", "signature"],
  "properties": {
    "schema_version": {"const": 1},
    "grant_id": {"$ref": "#/$defs/id"},
    "action_class": {"$ref": "#/$defs/id"},
    "policy_version": {"type": "integer", "minimum": 1},
    "approver_role": {"const": "founder"},
    "evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$", "description": "sha256 of the canonical JSON evidence packet that evaluated to candidate_for_manual_review_unverified"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profiles"],
      "properties": {
        "profiles": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "issued_at": {"$ref": "#/$defs/instant"},
    "expires_at": {"$ref": "#/$defs/instant"},
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "algorithm", "value"],
      "properties": {
        "key_id": {"$ref": "#/$defs/id"},
        "algorithm": {"const": "ed25519"},
        "value": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "instant": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
