{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodeme.io/contracts/events/envelope.v1.schema.json",
  "title": "Event envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "event_version", "occurred_at", "source", "actor",
               "correlation_id", "idempotency_key", "data_classification", "payload"],
  "properties": {
    "event_id": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "event_type": {"type": "string", "pattern": "^[a-z]+(\\.[a-z_]+)+$"},
    "event_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "occurred_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"},
    "source": {"type": "string", "minLength": 1, "maxLength": 64},
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["human", "agent", "service"]},
        "id": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "company_id": {"type": "string", "maxLength": 64},
    "tenant_id": {"type": "string", "maxLength": 64},
    "correlation_id": {"type": "string", "minLength": 8, "maxLength": 64},
    "causation_id": {"type": "string", "maxLength": 64},
    "idempotency_key": {"type": "string", "minLength": 8, "maxLength": 200},
    "data_classification": {"enum": ["public", "internal", "personal"]},
    "payload": {"type": "object"},
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trace_id": {"type": "string", "maxLength": 64},
        "span_id": {"type": "string", "maxLength": 32}
      }
    }
  }
}
