{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodeme.io/contracts/events/order.requested.v1.schema.json",
  "title": "order.requested v1",
  "allOf": [{"$ref": "https://kodeme.io/contracts/events/envelope.v1.schema.json"}],
  "properties": {
    "event_type": {"const": "order.requested"},
    "event_version": {"pattern": "^1\\."},
    "data_classification": {"enum": ["internal", "personal"]},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_order_id", "brand", "customer_ref", "channel", "lines"],
      "properties": {
        "work_order_id": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
        "brand": {"const": "terakidz"},
        "customer_ref": {"type": "string", "pattern": "^odoo:res\\.partner/[0-9]+$"},
        "channel": {"enum": ["webhook", "chatwoot", "web"]},
        "lines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["product_ref", "quantity"],
            "properties": {
              "product_ref": {"type": "string", "pattern": "^[A-Z0-9-]{3,32}$"},
              "quantity": {"type": "integer", "minimum": 1, "maximum": 100}
            }
          }
        }
      }
    }
  }
}
