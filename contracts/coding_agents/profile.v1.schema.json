{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodeme.io/contracts/coding_agents/profile.v1.schema.json",
  "title": "Independent OMP coding persona v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "harness", "principal", "roles", "default_model", "small_model", "optional_worker_model", "provider_transport", "automatic_paid_fallback", "production_access", "publication", "max_parallel_workers", "wall_clock_minutes", "activation"],
  "properties": {
    "profile": {"enum": ["friday-omp", "veronica-omp"]},
    "harness": {"const": "kodemeio-omp"},
    "principal": {"enum": ["agent:friday-omp", "agent:veronica-omp"]},
    "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["developer", "planner", "reviewer", "verifier"]}},
    "default_model": {"const": "openai-codex/gpt-6-sol"},
    "small_model": {"const": "openai-codex/gpt-6-luna"},
    "optional_worker_model": {"const": "deepseek/deepseek-flash"},
    "provider_transport": {"const": "direct"},
    "automatic_paid_fallback": {"const": false},
    "production_access": {"const": false},
    "publication": {"enum": ["operator-only-draft-pr", "none"]},
    "max_parallel_workers": {"type": "integer", "minimum": 1, "maximum": 2},
    "wall_clock_minutes": {"type": "integer", "minimum": 5, "maximum": 45},
    "activation": {"enum": ["local-available-credentials-pending", "authenticated-local", "remote-validated"]}
  },
  "allOf": [
    {"if": {"properties": {"profile": {"const": "friday-omp"}}}, "then": {"properties": {"principal": {"const": "agent:friday-omp"}, "roles": {"const": ["developer"]}, "publication": {"const": "operator-only-draft-pr"}}}},
    {"if": {"properties": {"profile": {"const": "veronica-omp"}}}, "then": {"properties": {"principal": {"const": "agent:veronica-omp"}, "roles": {"const": ["planner", "reviewer", "verifier"]}, "publication": {"const": "none"}}}}
  ]
}
