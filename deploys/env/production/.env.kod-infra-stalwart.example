# kod-infra-stalwart — names only. Real values live in the gitignored
# deploys/env/production/.env.kod-infra-stalwart (1Password item
# `kodemeio-platform/kod-infra-stalwart`). Consumed by
# deploys/composes/stalwart/docker-compose.yml.
#
# Permanent Stalwart administrator, created by the bootstrap. Not read by the
# compose; kept here so the credential has one home.
STALWART_ADMIN_USER=admin@kodeme.io
STALWART_ADMIN_PASSWORD=
# Roundcube session encryption key, exactly 24 characters.
ROUNDCUBE_DES_KEY=
TZ=Asia/Jakarta
#
# Recovery only — never leave set in production:
# STALWART_RECOVERY_ADMIN=admin:<password>
