# kod-infra-gatus — names only; real values live in 1Password + the gitignored
# .env.kod-infra-gatus. Consumed by ops/monitoring/gatus/docker-compose.yml.

# Telegram bot (BotFather) + alert chat — founder gate G3
GATUS_TELEGRAM_TOKEN=change-me
GATUS_TELEGRAM_CHAT_ID=change-me

# Email alerts via kod SMTP (port 587, STARTTLS) — founder gate G3
GATUS_SMTP_FROM=Kodemeio Monitor <ops@kodeme.io>
GATUS_SMTP_USER=change-me
GATUS_SMTP_PASS=change-me
GATUS_SMTP_HOST=mail.kodeme.io
GATUS_ALERT_TO=change-me

# Healthchecks.io ping URL for the Gatus heartbeat sidecar (check name: gatus,
# period 1 min, grace 5 min). A credential: whoever holds it can silence the alarm.
HC_GATUS_URL=change-me
