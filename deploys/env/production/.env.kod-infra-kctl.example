# kctl toolbox (kod-infra-kctl) -- execution host for the kod (Teracorp,
# kodeme.io) estate's scheduled backup-freshness and offsite-mirror jobs.
# Kodeme.io only: no IDTPP_*/B2_TPP_*/B2_MAC_*/Accurate name belongs here --
# see kodemeio-skills: compose/toolbox-kod.yml and tests/test_toolbox_kod.sh.
#
# Real values live in Dokploy's env store, never in git. Sources of truth:
#   - KOD_S3_*        : the kodemeio Hetzner Object Storage profile (kctl-hz)
#   - B2_KOD_*        : 1Password vault Kodemeio, "b2: kod-prod-backup-mirror"
#   - B2_KOD_RO_*     : 1Password vault Kodemeio, "b2: kod-prod-backup-ro"
#   - HC_KOD_*        : Healthchecks.io, one check per kod job
#   - SMTP_PASS/ALERT_TO: same reporting path as the idtpp/tpp+mac toolbox
#
# SMTP_PASS and ALERT_TO carry `:?` guards in compose/toolbox-kod.yml: the
# container refuses to start without them, because a toolbox that cannot
# report a failure turns all three kod jobs into unmonitored ones.
#
# Every value below is the literal placeholder "change-me" -- replace all of
# them in Dokploy's env store before this instance is ever deployed. See
# this manifest's own `schedules:` comment (kod-infra-kctl.yaml) for the
# founder gates that must ALSO pass before enabling the schedules themselves.

ALERT_TO=change-me
B2_KOD_APP_KEY=change-me
B2_KOD_KEY_ID=change-me
B2_KOD_RO_APP_KEY=change-me
B2_KOD_RO_KEY_ID=change-me
HC_KOD_HZ_FRESH=change-me
HC_KOD_OFFSITE_FRESH=change-me
HC_KOD_OFFSITE_MIRROR=change-me
JOBRUN_TIMEOUT=change-me
KOD_S3_ACCESS_KEY=change-me
KOD_S3_ENDPOINT=change-me
KOD_S3_REGION=change-me
KOD_S3_SECRET_KEY=change-me
MAIL_FROM=change-me
SMTP_HOST=change-me
SMTP_PASS=change-me
SMTP_PORT=change-me
SMTP_USER=change-me
TZ=change-me
