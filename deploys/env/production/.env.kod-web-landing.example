# kod-web-landing — Production (kod)  [server: abc-prod-02 · project: apps]
#
# The landing kernel's renderer (kodemeio-next apps/landing-web) serving the Terakidz
# campaign host. Copy to .env.kod-web-landing (gitignored) or paste into the Dokploy
# compose's environment editor. NO secrets: every value below is a hostname, a slug or a
# number — the app holds no credential of its own, and it talks to Odoo over the kernel's
# public /landing/v1/* routes only.
#
# The app's own contract (the same variable names, with the reasoning):
#   kodemeio-next/apps/landing-web/.env.example and README §Configuration.
#
# 🔴 Every variable is REQUIRED-ish for a deploy: the compose declares
# ODOO_BASE_URL and LANDING_HOST with `:?`, so Docker refuses to start an unroutable or
# unrenderable container rather than shipping one that reports healthy and 404s.

# --- image: pinned, never `latest` in production -------------------------------------
# Built from the MONOREPO ROOT (not apps/landing-web), pushed to GHCR, then pinned here:
#   cd kodemeio-next
#   docker build -f apps/landing-web/Dockerfile \
#     -t ghcr.io/tgunawandev/kodemeio-landing-web:sha-$(git rev-parse --short HEAD) .
#   docker push ghcr.io/tgunawandev/kodemeio-landing-web:sha-$(git rev-parse --short HEAD)
# Live at the time of writing: ghcr.io/tgunawandev/kodemeio-landing-web:sha-678db05
IMAGE=ghcr.io/tgunawandev/kodemeio-landing-web:sha-REPLACE

# --- required ------------------------------------------------------------------------
# The Odoo instance serving landing_base + api_landing (and the Terakidz company's
# landing.site). Use a hostname, never an IP: dbfilter resolves the database from it.
ODOO_BASE_URL=

# The ONE hostname Traefik routes to this container (its Host(...) rule). Every other
# hostname that reaches the container is resolved by Odoo's landing.domain rows, so a
# second campaign domain is a Dokploy domain entry or a Traefik rule — never a second
# service. Set it to the host the manifest's `domain.host` names.
LANDING_HOST=

# --- optional ------------------------------------------------------------------------
# Sent as X-Odoo-dbfilter, for an instance running OCA dbfilter_from_header.
ODOO_DBFILTER=

# The page served at `/` (unset → an index of the site's live pages).
LANDING_ROOT_SLUG=

# The A/B mirror, JSON — must mirror the variants RUNNING in Odoo. A stale key is safe
# (the API serves the page document and the event stream records the fallback).
# LANDING_VARIANT_PLAN={"*":[{"key":"a","share":50},{"key":"b","share":50}]}

# Data-cache window in seconds (60 = a published version appears within a minute).
LANDING_REVALIDATE_SECONDS=60

# Per-request timeout against Odoo, in milliseconds.
LANDING_FETCH_TIMEOUT_MS=5000
