# =============================================================================
# tpp-infra-drawio — TPP PRODUCTION (sanitized template)
# =============================================================================
# Self-hosted diagrams.net editor framed by Odoo's diagram_base module.
# Compose: kodemeio-odoo/compose/diagrams.drawio.yml (spec §8.1).
#
# Nothing here is secret: the editor is a static page with no database, no
# volume, no SSO and no cloud-integration client ids (Google / Microsoft /
# GitHub / GitLab / Dropbox stay unset on purpose — setting one would make the
# editor call that vendor). Copy to .env.tpp-infra-drawio as-is.

# Public hostname. Feeds DRAWIO_BASE_URL / DRAWIO_SERVER_URL in the compose.
DRAWIO_HOST=draw.idtpp.com

# Pinned jgraph/drawio tag. Bump deliberately, then re-run the zero-outbound
# check before pointing any Odoo at the new build.
DRAWIO_IMAGE_TAG=31.4.5

TZ=Asia/Jakarta
