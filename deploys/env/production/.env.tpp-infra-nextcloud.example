# =============================================================================
# kodemeio-nextcloud — Environment Template
# Instance: tpp-infra-nextcloud | Server: tpp-prod-04 | Domain: nextcloud.idtpp.com
# =============================================================================
# Copy to .env.tpp-infra-nextcloud and fill in the CHANGEME-* placeholders.
# Sanitized template — safe to commit.
# Generate secrets: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# =============================================================================

# ---- Compose ---------------------------------------------------------------
COMPOSE_PROJECT_NAME=tpp-infra-nextcloud
NEXTCLOUD_VERSION=34.0.3
REDIS_VERSION=7.4.11
TZ=Asia/Jakarta

# ---- Domain ----------------------------------------------------------------
NC_DOMAIN=nextcloud.idtpp.com
# Space-separated CIDRs Traefik connects from (docker bridge + Hetzner private)
TRUSTED_PROXIES=172.16.0.0/12 10.0.0.0/8 192.168.0.0/16

# ---- First-run admin (local account; SSO users come from Authentik) --------
# Only read by the installer on the very first boot. Log in at /login?direct=1
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=CHANGEME-ADMIN-PASSWORD

# ---- Database: shared tpp-infra-postgres (Hetzner private network) ---------
# Provision: kctl-pg -p idtpp users create nextcloud --password <pw>
#            kctl-pg -p idtpp db create nextcloud --owner nextcloud
POSTGRES_HOST=10.0.0.2
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=CHANGEME-DB-PASSWORD

# ---- Redis: dedicated, ephemeral (service `redis` inside compose) ----------
REDIS_PASSWORD=CHANGEME-REDIS-PASSWORD

# ---- Primary object storage: Hetzner S3 (bucket tpp-nextcloud) -------------
# Provision: kctl-hz -p idtpp s3 mb tpp-nextcloud
#            kctl-hz -p idtpp s3 versioning tpp-nextcloud --enable
#            kctl-hz -p idtpp s3 lifecycle tpp-nextcloud --expire-noncurrent-days 30
# Keys: Hetzner Console → Object Storage → S3 credentials (project-wide)
S3_HOST=fsn1.your-objectstorage.com
S3_REGION=fsn1
S3_BUCKET=tpp-nextcloud
S3_ACCESS_KEY=CHANGEME-S3-ACCESS-KEY
S3_SECRET_KEY=CHANGEME-S3-SECRET-KEY

# ---- SMTP: tpp-infra-mailcow ------------------------------------------------
# Provision: kctl-mailcow -p idtpp mailboxes add nextcloud idtpp.com \
#              --password <pw> --name "Nextcloud" --authsource mailcow
SMTP_HOST=mail.idtpp.com
SMTP_PORT=587
SMTP_USER=nextcloud@idtpp.com
SMTP_PASSWORD=CHANGEME-SMTP-PASSWORD
MAIL_FROM_ADDRESS=nextcloud
MAIL_DOMAIN=idtpp.com

# ---- Authentik OIDC (tpp-infra-authentik @ auth.idtpp.com) -----------------
# Not read by compose — consumed by scripts/nc-oidc.sh after first boot.
# Provision: ./scripts/setup-authentik.sh   (kctl-ak -p idtpp setup oauth2 ...)
OIDC_PROVIDER_URL=https://auth.idtpp.com/application/o/nextcloud/
OIDC_CLIENT_ID=CHANGEME-OIDC-CLIENT-ID
OIDC_CLIENT_SECRET=CHANGEME-OIDC-CLIENT-SECRET
# 1 = clicking "Log in" goes straight to Authentik (local login at /login?direct=1)
OIDC_AUTO_REDIRECT=1

# ---- Sizing ------------------------------------------------------------------
PHP_MEMORY_LIMIT=1G
PHP_UPLOAD_LIMIT=10G
NC_CPU_LIMIT=2.0
NC_MEMORY_LIMIT=2G
CRON_CPU_LIMIT=1.0
CRON_MEMORY_LIMIT=1G

# ---- Ops (scripts only) -------------------------------------------------------
AK_PROFILE=idtpp
# Run scripts from a laptop against the host:
#   export DOCKER_HOST=ssh://root@tpp-prod-01
