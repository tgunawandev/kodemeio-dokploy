# Teracorp CW1 -- Chatwoot + kido_chat + order_intake ingress
# (kod-app-chatwoot). Names only; every value is the literal placeholder
# "change-me" -- replace all of them in Dokploy's env store before this
# instance is ever deployed -- EXCEPT the two where a placeholder would be
# wrong and is called out where it appears: LOG_LEVEL (info) and
# SAFE_FETCH_ALLOW_PRIVATE_NETWORK (true, a real founder decision -- Chatwoot
# casts any non-false string to true, so "change-me" would silently enable it).
# The KEY SET must stay identical to kodemeio-chatwoot/.env.example, which is
# the reviewed source of truth operators copy from; drift between the two is
# what let the WhatsApp app secret go missing here (final review I1). Enforced
# by deploys/tests/test_chatwoot_env_parity.py (the same discipline as
# kodemeio-dsh's own .env.example / friday.yaml pair, see
# deploys/tests/test_friday_broker_repos.py).
#
# Real values: 1Password vault "Kodemeio", item "CW1 -- Chatwoot/kido_chat/
# order_intake production". See ops/runbooks/teracorp-cw1-rollout.md for the
# full deploy order and the founder gates (M1-M7) each group below waits on.

# Custom-built images -- PENDING, no publish pipeline defined yet (kido_chat
# and order_intake live in the sibling kodemeio-hatchet repo). Must be a
# specific tag or digest, never `:latest`.
KIDO_CHAT_IMAGE=change-me
ORDER_INTAKE_IMAGE=change-me

# Chatwoot core (Rails) -- M6
# REQUIRED: the Meta app secret (M2). Chatwoot does not verify inbound
# WhatsApp signatures at all when this is unset, so a forged webhook would be
# accepted -- leave the placeholder and the stack refuses to start.
WHATSAPP_APP_SECRET=change-me
# Required for this stack, and a deliberate, founder-gated relaxation of
# Chatwoot's SSRF guard. SafeFetch resolves the URL and refuses one whose host
# has no PUBLIC address -- which is every host on cw-internal, including the
# agent bot's own outgoing_url (http://kido-chat:8080/chatwoot/bot). Setting
# this true makes Chatwoot use SafeFetch::PrivateNetworkRequest, which skips
# the resolution check ENTIRELY: RFC1918, loopback (127.0.0.0/8, ::1) and
# link-local/metadata (169.254.0.0/16) all become reachable. Chatwoot 4.18
# offers no host-scoped allowlist (ssrf_filter 1.5.0 has only a scheme
# whitelist), so the mitigation is the network boundary: kido-chat and the
# order_intake ingress publish no port and are reachable only from this
# compose. Recorded as residual risk in the CW1 results doc; revisit if
# Chatwoot ships a host allowlist.
# NEVER a placeholder here: Chatwoot reads this with
# ActiveModel::Type::Boolean -- any value that is not an explicit false
# ("0"/"false"/"off") casts to TRUE, "change-me" included, so a placeholder
# would silently open exactly what this comment documents. The compose's own
# default is false (docker-compose.prod.yml); this value is the founder's
# decision (rollout runbook, M6).
SAFE_FETCH_ALLOW_PRIVATE_NETWORK=true
DOMAIN=change-me
SECRET_KEY_BASE=change-me
LOG_LEVEL=info
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=change-me
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=change-me
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=change-me
DEFAULT_LOCALE=change-me
RAILS_MAX_THREADS=change-me
SIDEKIQ_CONCURRENCY=change-me

# Chatwoot's own internal Postgres/Redis (pgvector required -- not the
# shared kod postgres)
POSTGRES_USERNAME=change-me
POSTGRES_PASSWORD=change-me
POSTGRES_DATABASE=change-me
REDIS_PASSWORD=change-me

# SMTP
MAILER_SENDER_EMAIL=change-me
SMTP_ADDRESS=change-me
SMTP_PORT=change-me
SMTP_USERNAME=change-me
SMTP_PASSWORD=change-me
SMTP_AUTHENTICATION=change-me
SMTP_DOMAIN=change-me
SMTP_ENABLE_STARTTLS_AUTO=change-me

# Attachment storage (S3-compatible; optional -- local volume otherwise)
ACTIVE_STORAGE_SERVICE=change-me
S3_BUCKET_NAME=change-me
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
AWS_REGION=change-me
AWS_ENDPOINT=change-me
DIRECT_UPLOADS_ENABLED=change-me

# Staff push notifications (optional)
VAPID_PUBLIC_KEY=change-me
VAPID_PRIVATE_KEY=change-me

# kido_chat -- shared by kido-chat and kido-chat-worker. KIDO_ENABLED is
# kill switch #1 (spec D12): only the literal "1" turns it on.
# FOUNDER DECISION PENDING (M4): stays "0" until the founder approves a
# grp-personal vetted-LLM provider for personal-data text (contracts/agents/
# kido_chat.yaml's llm_usd_per_day also stays 0 until then).
KIDO_ENABLED=change-me
LITELLM_URL=change-me
LITELLM_KEY=change-me
KIDO_MODEL=change-me
ODOO_URL=change-me
ODOO_DB=change-me
KIDO_CHAT_MCP_TOKEN=change-me
# Non-admin Chatwoot AGENT user's access token, never an admin token, never
# an AgentBot token. SCOPE RISK (R6): this token can read every contact in
# the account -- see the rollout runbook before provisioning it.
CHATWOOT_CONTACT_TOKEN=change-me
# Shared HMAC secret between kido_chat and the order_intake ingress (D2) --
# MUST equal ORDER_INTAKE_SECRET_CHATWOOT below.
KIDO_INTAKE_SECRET=change-me
# Per-tenant AgentBot secret + token for config/tenants.yaml's "terakidz"
# row -- Chatwoot generates both when the bot is created (M6); the operator
# cannot choose them.
KIDO_BOT_SECRET_TERAKIDZ=change-me
KIDO_BOT_TOKEN_TERAKIDZ=change-me

# order_intake -- shared by order-intake-ingress and order-intake-worker
TERAKIDZ_COMPANY_REF=change-me
# MUST equal KIDO_INTAKE_SECRET above.
ORDER_INTAKE_SECRET_CHATWOOT=change-me
# order_intake's own 'kido' MCP key -- NOT the same value as
# KIDO_CHAT_MCP_TOKEN above.
MCP_TOKEN=change-me
ORDER_INTAKE_NOTIFY_URL=change-me
# Healthchecks.io ping URL for the (disabled-by-default) `unconfirmed`
# schedule -- see kod-app-chatwoot.yaml's `schedules:` block.
HC_CW1_ORDER_INTAKE_UNCONFIRMED=change-me

# Hatchet client -- shared by all four kido_chat/order_intake services
# (the hatchet.kodeme.io engine)
HATCHET_CLIENT_TOKEN=change-me
HATCHET_CLIENT_TLS_STRATEGY=change-me
