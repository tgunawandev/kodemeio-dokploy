# kod-infra-litellm — sanitized contract. Real secrets live in the gitignored
# sibling .env.kod-infra-litellm (operator-managed), never in git. See
# kodemeio-llmlite/docs/runbook-production.md for how these get set.

# LiteLLM's own master key (bearer token for /key/*, /model/*, /team/*, ...
# management routes and the admin UI). Generate: openssl rand -hex 32,
# prefixed sk-.
LITELLM_MASTER_KEY=sk-change-me-long-random

# Placement (kodemeio-llmlite docs/runbook-production.md Step 1):
#   A. co-located on dsh's host: COMPOSE_PROFILES=colocated starts the
#      compose's own PostgreSQL 16 (`litellm-db`) with LITELLM_DB_PASSWORD, and
#      DATABASE_URL=postgresql://litellm:<LITELLM_DB_PASSWORD>@litellm-db:5432/litellm
#   B. shared kod postgres (abc-prod-02): leave COMPOSE_PROFILES and
#      LITELLM_DB_PASSWORD unset; DATABASE_URL points at the `litellm`
#      database provisioned via kod-infra-postgres's SERVICE_DATABASES (see
#      ../production/.env.kod-infra-postgres.example) -- that alias only
#      resolves on abc-prod-02.
# COMPOSE_PROFILES=colocated
# LITELLM_DB_PASSWORD=change-me
DATABASE_URL=postgresql://litellm:change-me@kod-infra-postgres:5432/litellm

# Provider keys held ONLY here after the runbook's switch-over steps — never
# in an agent's own env once this gateway is live.
DEEPSEEK_API_KEY=change-me
OPENROUTER_API_KEY=change-me
ANTHROPIC_API_KEY=change-me

# Optional: only needed if the server this instance runs on is not colocated
# with Authentik's own container — see docker-compose.prod.yml's Traefik
# label comments. Unset uses the default http://authentik-server:9000.
# Placement A (kod-prod-02, which runs the kod-dsh-outpost remote outpost):
# AUTHENTIK_HOST=http://authentik-outpost:9000
