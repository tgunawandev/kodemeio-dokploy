# kod-infra-ntfy — names only. Real values live in 1Password (Kodemeio vault,
# item `kod-infra-ntfy`) and the gitignored
# deploys/env/production/.env.kod-infra-ntfy. Consumed by
# deploys/composes/ntfy/docker-compose.yml.
#
# NTFY_ADMIN_*   — ntfy web UI + phone app login (role admin).
# NTFY_AGENTS_*  — service account the Pi extension and the Codex notify hook
#                  use to publish; read-write on NTFY_TOPIC only.
# NTFY_TOPIC     — the topic agents publish to.

NTFY_ADMIN_USER=kodeme
NTFY_ADMIN_PASSWORD=change-me
NTFY_AGENTS_USER=orca-agents
NTFY_AGENTS_PASSWORD=change-me
NTFY_TOPIC=kod-orca-agents
NTFY_ACK_TOPIC=kod-orca-acks
