# =============================================================================
# tpp-infra-waha — TPP PRODUCTION (sanitized template)
# =============================================================================
# WAHA for the idtpp Odoo fleet. Compose: kodemeio-waha/docker-compose.idtpp.yml.
# Copy to .env.tpp-infra-waha and fill the three secrets with fresh random
# values (e.g. `openssl rand -hex 32`). Keep the real file out of git; keep a
# copy in 1Password.

# API key for every /api/ call. Odoo's whatsapp_waha accounts store the same
# key (system-group field waha_api_key); rotating it means updating each account.
WAHA_API_KEY=

# WAHA's own dashboard and Swagger logins. They sit behind Authentik
# forward-auth as well; these are the second factor, not the only one.
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=

DOMAIN=waha.idtpp.com
TENANT=tpp
AUTHENTIK_HOST=http://authentik-server:9000
WAHA_TAG=noweb-2026.8.2
TZ=Asia/Jakarta
