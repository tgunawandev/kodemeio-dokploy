# =============================================================================
# KOD Full Odoo (all modules, all PWA apps) — Production Environment
# =============================================================================
# Instance: kod-odoo-full.kodeme.io
# Recipe:   full
# Profile:  erp
# Extras:   core-hr,core-maintenance,core-fleet,oca-report,oca-hr,oca-maintenance,oca-pos,oca-saas,private-finance-hr,private-form,private-sfa,private-lfa,private-mrp,private-hrm,private-desktop-apps,private-retail,private-analytics,private-asset,private-recruitment,private-saas
# =============================================================================

# PROJECT IDENTIFICATION
COMPOSE_PROJECT_NAME=kod-odoo-full
TENANT=kod
DOMAIN=kod-odoo-full.kodeme.io

# DATABASE
PGHOST=10.0.0.3
PGPORT=5432
PGUSER=odoo
PGPASSWORD=CHANGE_ME
PGDATABASE=kod_odoo_full
ODOO_DB_MAXCONN=32

# ODOO CORE
ODOO_ADMIN_PASSWD=CHANGE_ME
ODOO_DB_FILTER=^kod_odoo_full$
ODOO_DB_NAME=kod_odoo_full
ODOO_LIST_DB=False
ODOO_INIT_DB=true
RUNNING_ENV=production
WITHOUT_DEMO=True
ODOO_HTTP_PORT=8069
ODOO_GEVENT_PORT=8072
ODOO_DATA_DIR=/var/lib/odoo
ODOO_LOG_LEVEL=warn
ODOO_SERVER_WIDE_MODULES=base,web,bus,bus_alt_connection,session_db,dbfilter_from_header

# ERROR REPORTING (Sentry / GlitchTip) — Wave 0 redaction contract v1
# kodemeio-odoo docker/sentry_init.py is the ONE Sentry init for kod and it
# scrubs secrets/PII (contracts/observability/redaction.v1.yaml). Keep the OCA
# `sentry` module OUT of ODOO_SERVER_WIDE_MODULES above (it is, unlike the
# compose default) so there is never a second, unscrubbed init. The compose
# defaults SENTRY_INCLUDE_CONTEXT to true — kod sets it false (no request
# context / user data attached by the OCA module if it is ever enabled).
# SENTRY_DSN stays empty until a GlitchTip exists on kod (none is deployed).
SENTRY_DSN=
SENTRY_INCLUDE_CONTEXT=false

# DEPLOY PROFILE
ODOO_DEPLOY_PROFILE=erp
ODOO_INSTALL_BUNDLE=core-hr,core-maintenance,core-fleet,oca-report,oca-hr,oca-maintenance,oca-pos,oca-saas,private-finance-hr,private-form,private-sfa,private-lfa,private-mrp,private-hrm,private-desktop-apps,private-retail,private-analytics,private-asset,private-recruitment,private-saas
ODOO_RUN_UPDATE=false

# WORKERS
ODOO_WORKERS=6
ODOO_MAX_CRON_THREADS=2
ODOO_QUEUE_JOB_CHANNELS=root:2

# RESOURCES
CPU_LIMIT=2
MEMORY_LIMIT=4G
CPU_LIMIT_CRON=1
MEMORY_LIMIT_CRON=1G
ODOO_LIMIT_MEMORY_SOFT=2147483648
ODOO_LIMIT_MEMORY_HARD=4294967296
ODOO_LIMIT_TIME_CPU=600
ODOO_LIMIT_TIME_REAL=1200
ODOO_LIMIT_TIME_REAL_CRON=1800

# SMTP
SMTP_SERVER=mail.kodeme.io
SMTP_PORT=587
SMTP_USER=kod@kodeme.io
SMTP_PASSWORD=CHANGE_ME
SMTP_SSL=True
EMAIL_FROM=kod@kodeme.io

# STORAGE
IR_ATTACHMENT_LOCATION=file
TZ=Asia/Jakarta
IMAGE_TAG=latest
