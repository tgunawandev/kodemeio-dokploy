# =============================================================================
# PostgreSQL Production Environment — sanitized contract.
# Real secrets live in the gitignored sibling .env.kod-infra-postgres
# (operator-managed), never in git.
# =============================================================================
# Copy to .env or configure in Dokploy Environment Variables
# =============================================================================

# -----------------------------------------------------------------------------
# Database Credentials
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=postgres

# -----------------------------------------------------------------------------
# Performance Tuning (sized for production workloads)
# -----------------------------------------------------------------------------
POSTGRES_MAX_CONNECTIONS=400
POSTGRES_SHARED_BUFFERS=4GB
POSTGRES_CACHE_SIZE=12GB
POSTGRES_WORK_MEM=64MB
POSTGRES_MAINTENANCE_WORK_MEM=1GB

# -----------------------------------------------------------------------------
# Resource Limits (adjust based on server specs)
# -----------------------------------------------------------------------------
CPU_LIMIT=4
MEMORY_LIMIT=16G

# -----------------------------------------------------------------------------
# Application User (auto-created via initdb/03-app-user.sh)
# -----------------------------------------------------------------------------
APP_DB_USER=app
APP_DB_PASSWORD=change-me-long-random

# -----------------------------------------------------------------------------
# Replication Settings
# -----------------------------------------------------------------------------
MAX_WAL_SENDERS=20
MAX_REPLICATION_SLOTS=20
REPLICATION_USER=replicator
REPLICATION_PASSWORD=change-me-long-random

# -----------------------------------------------------------------------------
# PgBouncer Connection Pooling
# -----------------------------------------------------------------------------
# PgBouncer auth user password (for auth_query)
PGBOUNCER_PASSWORD=change-me-long-random
# Pool settings
PGBOUNCER_POOL_SIZE=50
PGBOUNCER_MAX_CLIENT_CONN=500

# -----------------------------------------------------------------------------
# S3 Backup/Restore (used by /scripts/s3.sh)
# -----------------------------------------------------------------------------
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=kodemeio-dokploy
S3_ENDPOINT=nbg1.your-objectstorage.com
S3_REGION=nbg1

# -----------------------------------------------------------------------------
# PITR - Point-in-Time Recovery via pgBackRest (optional)
# -----------------------------------------------------------------------------
# Set PITR_ENABLED=true to enable continuous WAL archiving to S3.
# Requires S3_* credentials above to be configured.
# After enabling, run: docker exec postgres /scripts/pitr.sh init
# Then: docker exec postgres /scripts/pitr.sh backup
PITR_ENABLED=false
# PITR_RETENTION_FULL=2
# PITR_RETENTION_DIFF=14
# PITR_PROCESS_MAX=2
# PITR_CIPHER_TYPE=aes-256-cbc
# PITR_CIPHER_PASS=<GENERATE_STRONG_PASSPHRASE>

# -----------------------------------------------------------------------------
# Service Databases (auto-provisioned by postgres-init on every deploy)
# -----------------------------------------------------------------------------
# Format: db1:user1:pass1,db2:user2:pass2
#
# `litellm` added for Task 5 (teracorp-litellm-gateway): the LiteLLM gateway's
# own state (virtual keys, budgets, spend logs — no prompt/completion text,
# see kodemeio-llmlite/config/config.prod.yaml's turn_off_message_logging).
# It rides this instance's existing backup — no separate backup job needed
# for kod-infra-litellm (see that manifest's header comment).
SERVICE_DATABASES=authentik:authentik:change-me,zulip:zulip:change-me,outline:outline:change-me,gatus:gatus:change-me,glitchtip:glitchtip:change-me,hmdm:hmdm:change-me,litellm:litellm:change-me

# -----------------------------------------------------------------------------
# Ports (change if conflicts with other services)
# -----------------------------------------------------------------------------
POSTGRES_PORT=5432
PGBOUNCER_PORT=6432
POSTGRES_EXPORTER_PORT=9187
