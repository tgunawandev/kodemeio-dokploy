# =============================================================================
# Pakerti 2025 ERP — Import + Trading + Distribution (multi-company, 43 CVs) — Staging Environment
# =============================================================================
# Instance: tpp25-odoo-erp-stg.idtpp.com
# Recipe:   import
# Profile:  erp
# Extras:   (none)
# =============================================================================

# PROJECT IDENTIFICATION
COMPOSE_PROJECT_NAME=tpp25-odoo-erp
TENANT=tpp25
DOMAIN=tpp25-odoo-erp-stg.idtpp.com

# DATABASE
PGHOST=10.0.0.3
PGPORT=5432
PGUSER=odoo
PGPASSWORD=CHANGE_ME
PGDATABASE=tpp25_odoo_erp_stg
ODOO_DB_MAXCONN=32

# ODOO CORE
ODOO_ADMIN_PASSWD=CHANGE_ME
ODOO_DB_FILTER=^tpp25_odoo_erp_stg$
ODOO_DB_NAME=tpp25_odoo_erp_stg
ODOO_LIST_DB=False
ODOO_INIT_DB=true
RUNNING_ENV=staging
WITHOUT_DEMO=True
ODOO_HTTP_PORT=8069
ODOO_GEVENT_PORT=8072
ODOO_DATA_DIR=/var/lib/odoo
ODOO_LOG_LEVEL=warn
ODOO_SERVER_WIDE_MODULES=base,web,bus,bus_alt_connection,session_db,dbfilter_from_header

# DEPLOY PROFILE
ODOO_DEPLOY_PROFILE=erp
ODOO_RUN_UPDATE=false

# WORKERS
ODOO_WORKERS=4
ODOO_MAX_CRON_THREADS=2
ODOO_QUEUE_JOB_CHANNELS=root:2

# RESOURCES
CPU_LIMIT=2
MEMORY_LIMIT=4G
CPU_LIMIT_CRON=1
MEMORY_LIMIT_CRON=1G
ODOO_LIMIT_MEMORY_SOFT=2147483648
ODOO_LIMIT_MEMORY_HARD=4294967296
ODOO_LIMIT_TIME_CPU=600
ODOO_LIMIT_TIME_REAL=1200
ODOO_LIMIT_TIME_REAL_CRON=1800

# SMTP
SMTP_SERVER=mail.kodeme.io
SMTP_PORT=587
SMTP_USER=tpp25@kodeme.io
SMTP_PASSWORD=CHANGE_ME
SMTP_SSL=True
EMAIL_FROM=tpp25@kodeme.io

# STORAGE
IR_ATTACHMENT_LOCATION=file
TZ=Asia/Jakarta
IMAGE_TAG=latest
